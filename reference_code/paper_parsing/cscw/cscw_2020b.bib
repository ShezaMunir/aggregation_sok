@article{10.1145/3415161,
author = {Kim, Juho and Lindley, Si\^{a}n and Schoenebeck, Sarita},
title = {PACMHCI V4 CSCW2 Oct 2020 Editorial},
year = {2020},
issue_date = {October 2020},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {4},
number = {CSCW2},
url = {https://doi-org.myaccess.library.utoronto.ca/10.1145/3415161},
