@inproceedings{10.1145/3465416.3483294,
author = {Vecchione, Briana and Levy, Karen and Barocas, Solon},
title = {Algorithmic Auditing and Social Justice: Lessons from the History of Audit Studies},
year = {2021},
isbn = {9781450385534},
